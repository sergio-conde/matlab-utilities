%         elseif all(cellfun(@isnumeric,{entryList.(requestFields{ivar})}))
%             if isfield(fcn_cfg.ref,requestFields{ivar})
%                 if strcmp(fcn_cfg.ref.(requestFields{ivar}),'lower')
%                     checkFlags(:,nval) = [entryList(:).(requestFields{ivar})] < loc_val;
%                 elseif strcmp(fcn_cfg.ref.(requestFields{ivar}),'higher')
%                     checkFlags(:,nval) = [entryList(:).(requestFields{ivar})] > loc_val;
